{
  "manifest_version": 3,
  "name": "NPF- & Tillgänglighetssimulator",
  "version": "1.0.1",
  "description": "Pedagogiskt verktyg för lärare att simulera och uppleva NPF-utmaningar i Google Classroom, Google Dokument och webbläsaren.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://classroom.google.com/*",
    "https://docs.google.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Öppna NPF-simulatorn",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://classroom.google.com/*",
        "https://docs.google.com/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "filters.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
